# --- Database (PostgreSQL 15+) ---
DATABASE_URL=postgres://postgres:postgres@localhost:5432/ada_dev
# Used only by `npm test` (integration tests run against a separate, disposable DB)
TEST_DATABASE_URL=postgres://postgres:postgres@localhost:5432/ada_test

# --- Model provider (server only; never exposed to the browser) ---
OPENAI_API_KEY=
# Optional: OpenAI-compatible endpoint
OPENAI_BASE_URL=
ADA_MODEL_CLARIFY=gpt-4.1-mini
ADA_MODEL_COMPILE=gpt-4.1
ADA_MODEL_TUTOR=gpt-4.1-mini
ADA_MODEL_EVALUATE=gpt-4.1-mini
ADA_MODEL_TIMEOUT_MS=45000
# Per-user model-call ceilings (cost guard)
ADA_MODEL_CALLS_PER_MINUTE=20
ADA_MODEL_CALLS_PER_DAY=400

# Deterministic fake model for development/tests ONLY. The UI shows a visible banner when on.
MOCK_MODEL=false

APP_BASE_URL=http://localhost:3000
