# --- Database (PostgreSQL 15+; Supabase works) ---
# App runtime. On Vercel + Supabase use the TRANSACTION pooler URL (port 6543).
DATABASE_URL=postgres://postgres:postgres@localhost:5432/ada_dev
# Optional: URL used by `npm run db:migrate`. On Supabase use the SESSION pooler URL (port 5432).
MIGRATION_DATABASE_URL=
# Used only by `npm test` (integration tests reset this database)
TEST_DATABASE_URL=postgres://postgres:postgres@localhost:5432/ada_test
# Optional overrides: DB_POOL_MAX (default 10 locally, 3 on Vercel), DB_SSL=require|disable

# --- Model providers (server only; never exposed to the browser) ---
# Set one or both. With both, ADA_MODEL_PROVIDER is tried first and the other is the fallback.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# openai | anthropic (default: whichever key is set; openai if both)
ADA_MODEL_PROVIDER=
# Fall back to the other provider on timeouts/outages when both keys are set (default true)
ADA_MODEL_FALLBACK=true

# OpenAI model IDs per operation
OPENAI_BASE_URL=
ADA_MODEL_CLARIFY=gpt-4.1-mini
ADA_MODEL_COMPILE=gpt-4.1
ADA_MODEL_TUTOR=gpt-4.1-mini
ADA_MODEL_EVALUATE=gpt-4.1-mini

# Anthropic model IDs per operation
ADA_ANTHROPIC_MODEL_CLARIFY=claude-opus-5-5
ADA_ANTHROPIC_MODEL_COMPILE=claude-opus-5-5
ADA_ANTHROPIC_MODEL_TUTOR=claude-opus-5-5
ADA_ANTHROPIC_MODEL_EVALUATE=claude-opus-5-5
# Reasoning effort per operation: low | medium | high | xhigh | max
# Quick, learner-facing steps (setup questions, activities, hints, explanations); default low
ADA_ANTHROPIC_EFFORT_FAST=
# Course planning, plan revisions, free-response grading; default medium
ADA_ANTHROPIC_EFFORT_DEEP=
# Optional fallback for both of the above
ADA_ANTHROPIC_EFFORT=

# Let Claude search the web while writing explanations and show the sources: on | off (default off)
ADA_WEB_GROUNDING=off

# Email (Resend). Both are needed for password reset and review reminders; without them nothing is sent.
RESEND_API_KEY=
# The sender. Its domain must be verified in Resend, e.g. "Ada <ada@yourdomain.com>".
EMAIL_FROM=

# Secret for scheduled jobs (cleanup and reminders), sent as a Bearer token. 16+ random characters.
CRON_SECRET=

# Prepare the next activity in the background: background (default) | sync (tests) | off
ADA_PREFETCH=

# Per-call timeout (ms), shared by both providers
ADA_MODEL_TIMEOUT_MS=60000
# Per-user model-call ceilings (cost guard)
ADA_MODEL_CALLS_PER_MINUTE=20
ADA_MODEL_CALLS_PER_DAY=400
# Guests (no account): smaller daily model budget, and new guest identities per IP per hour
ADA_GUEST_MODEL_CALLS_PER_DAY=60
ADA_GUEST_CREATIONS_PER_HOUR=10

# Deterministic fake model for development/tests ONLY. The UI shows a visible banner when on.
MOCK_MODEL=false

APP_BASE_URL=http://localhost:3000
